{
  "name": "podnarr-api",
  "account_id": "24d3bab86b3b44170195747d8f330d4e",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-09",
  "workers_dev": true,
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  "assets": {
    "directory": "../../ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "podnarr",
      "database_id": "134eb8ad-82ff-44f7-ad7d-d0de9d4db26a",
      "migrations_dir": "./schema"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "podnarr-audio"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PROCESSING_QUEUE",
        "queue": "podnarr-processing"
      }
    ]
  },
  "vars": {
    "PUBLIC_UI_BASE_URL": "https://podnarr.yet-to-be.com",
    "APP_BASE_URL": "https://podnarr.yet-to-be.com",
    "PROCESSING_VERSION": "v1",
    "MAX_POSTS_PER_REFRESH": "0",
    "AUTO_QUEUE_NARRATION": "false"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "routes": [
    { "pattern": "podnarr.yet-to-be.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
