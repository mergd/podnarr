{
  "name": "podnarr-processor",
  "account_id": "24d3bab86b3b44170195747d8f330d4e",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-09",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "AudioServiceContainer",
      "image": "../../services/audio/Dockerfile",
      "image_build_context": "../../",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AUDIO_SERVICE",
        "class_name": "AudioServiceContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AudioServiceContainer"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "podnarr",
      "database_id": "134eb8ad-82ff-44f7-ad7d-d0de9d4db26a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "podnarr-audio"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PROCESSING_QUEUE",
        "queue": "podnarr-processing"
      }
    ],
    "consumers": [
      {
        "queue": "podnarr-processing",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 2,
        "retry_delay": 30
      }
    ]
  },
  "vars": {
    "PROCESSING_VERSION": "v1",
    "DEFAULT_TTS_PROVIDER": "fish_audio",
    "DEFAULT_TTS_MODEL": "s2.1-pro-free",
    "DEFAULT_TTS_VOICE": "bf322df2096a46f18c579d0baa36f41d"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
